# =====================================================================
#  Configuration EONE-Test — copiez ce fichier en `backend/.env`.
#  Les valeurs « SERVEUR » sont celles à mettre en production.
# =====================================================================

# --- Django ---
# SERVEUR : DEBUG=False
DEBUG=True
# Obligatoire si DEBUG=False (python3 -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=
# SERVEUR : ajoutez l'IP publique (ou le domaine), ex. localhost,127.0.0.1,backend,203.0.113.10
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- HTTPS (Caddy, uniquement avec `docker compose --profile https`) ---
# SERVEUR : l'IP publique du serveur (ex. 203.0.113.10) ou un nom de domaine.
SITE_ADDRESS=localhost
# « shortlived » (≈ 6 jours, obligatoire pour une IP) ou « classic » (domaine).
ACME_PROFILE=shortlived

# --- Lien du candidat (copié par l'admin) : {FRONTEND_URL}/passer-test?token=... ---
# Dev (vite) : http://localhost:5173 — Docker local : http://localhost:8080
# SERVEUR : https://<IP publique ou domaine>   (doit correspondre à SITE_ADDRESS)
FRONTEND_URL=http://localhost:8080

# --- PostgreSQL ---
# En local : le conteneur `postgres` de docker-compose est publié sur 127.0.0.1:5433.
# Dans Docker, le backend utilise automatiquement POSTGRES_HOST=postgres et POSTGRES_PORT=5432.
# Le mot de passe n'est pris en compte qu'à la première création du volume.
POSTGRES_DB=eone_test
POSTGRES_USER=eone_test
POSTGRES_PASSWORD=ChangeMeDb123!
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Compte administrateur (créé au démarrage par `manage.py ensure_admin`) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- Sécurité ---
# Durée de validité d'une connexion admin (heures).
TOKEN_TTL_HOURS=12
# Nombre de proxys devant Django (Caddy + nginx = 2). Sert à identifier l'IP
# réelle pour la limite de 10 tentatives de connexion par minute.
NUM_PROXIES=2
